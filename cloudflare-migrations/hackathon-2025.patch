+import process from 'node:process'
+
+const url = process.env.SUPABASE_URL || process.env.NUXT_PUBLIC_SUPABASE_URL
+const key = process.env.SUPABASE_KEY || process.env.NUXT_PUBLIC_SUPABASE_KEY
